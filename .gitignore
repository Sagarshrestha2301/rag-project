# Data, models and indexes are never committed
/data/
/models/
*.sqlite
*.lance/

# Python
.venv/
__pycache__/
*.pyc

# Tool marker folder (not project content)
.freebuff/
/tools/

# Generated eval review page (rebuild with eval/build_review.py)
/eval/review.html
/eval/review_pages/
/eval/fixtures/

# Local dev logs
/logs/

# Derived retrieval cache (rebuilds from data/corpus)
/index/

# Verification outputs
/artifacts/

# Index backups (manifest + artifacts, restorable)
/backups/
